<?xml version="1.0"?>
<!--
General OIDC settings for the galaxytrakr SANDBOX. Values match the shipped
oidc_config.xml.sample; nothing here is tuned for the mock provider.

VERIFY_SSL is False in the sample and stays False here. The mock provider is
plain HTTP on 127.0.0.1 so there is no certificate to verify either way — but
note that this setting is instance-wide, so a production instance should set it
True and reach its IdP over HTTPS.
-->
<OIDC>
    <Setter Property="VERIFY_SSL" Value="False" Type="bool"/>
    <Setter Property="REQUESTS_TIMEOUT" Value="3600" Type="float"/>
    <Setter Property="ID_TOKEN_MAX_AGE" Value="3600" Type="float"/>
</OIDC>
